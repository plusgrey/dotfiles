# Font configuration
font-family = MesloLGS Nerd Font Mono
font-size = 13.5

# Window configuration
window-decoration = true
window-padding-x = 5
window-padding-y = 5
window-width = 160
window-height = 50

# Theme and Colors
# VSCode Dark+ Colors
#background = #1e1e1e
#foreground = #d4d4d4
#selection-background = #264f78
#selection-foreground = #ffffff
#palette = 0=#000000
#palette = 1=#cd3131
#palette = 2=#0dbc79
#palette = 3=#e5e510
#palette = 4=#2472c8
#palette = 5=#bc3fbc
#palette = 6=#11a8cd
#palette = 7=#e5e5e5
#palette = 8=#666666
#palette = 9=#f14c4c
#palette = 10=#23d18b
#palette = 11=#f5f543
#palette = 12=#3b8eea
#palette = 13=#d670d6
#palette = 14=#29b8db
#palette = 15=#e5e5e5

theme = Dark Modern
background-opacity = 0.9


# Cursor
cursor-style = bar
cursor-style-blink = true

# Shell
command = /bin/zsh

# Scrollback
scrollback-limit = 800000


# Keybindings
# Unbind all default keybindings
keybind = clear

# New Window (Ctrl+Shift+Enter)
keybind = ctrl+shift+enter=new_window

# Close Window/Surface (Ctrl+Shift+W)
keybind = ctrl+shift+w=close_surface

# Splits
# Horizontal split (Ctrl+Shift+H) - Ghostty "right" is horizontal
keybind = ctrl+shift+h=new_split:right
# Vertical split (Ctrl+Shift+S) - Ghostty "down" is vertical
keybind = ctrl+shift+s=new_split:down

# Tab Navigation
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+right=next_tab

# Copy / Paste
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

keybind = ctrl+1=text:\x1b[27;5;49~
keybind = ctrl+2=text:\x1b[27;5;50~
keybind = ctrl+3=text:\x1b[27;5;51~
keybind = ctrl+4=text:\x1b[27;5;52~
keybind = ctrl+5=text:\x1b[27;5;53~
keybind = ctrl+6=text:\x1b[27;5;54~
keybind = ctrl+7=text:\x1b[27;5;55~
keybind = ctrl+8=text:\x1b[27;5;56~
keybind = ctrl+9=text:\x1b[27;5;57~
# 自定义字体大小调整快捷键（如果默认的冲突）
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

